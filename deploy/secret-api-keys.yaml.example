# API keys secret -- TEMPLATE
#
# Copy this file, fill in real values, and apply:
#   cp secret-api-keys.yaml.example secret-api-keys.yaml
#   # Edit secret-api-keys.yaml with real values
#   oc apply -f secret-api-keys.yaml
#
# NEVER commit the filled-in version to git.
---
apiVersion: v1
kind: Secret
metadata:
  name: opencode-api-keys
  namespace: openshell-poc
  labels:
    app.kubernetes.io/part-of: openshell-sandbox-poc
type: Opaque
stringData:
  # API key for OpenCode to authenticate with vLLM.
  # For local vLLM without auth, use any non-empty string.
  OPENAI_API_KEY: "dummy-key-for-local-vllm"
